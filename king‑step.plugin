#!name = 森林step自动提交
#!desc = 蚂蚁森林每日自动步数
#!author = 2026.9.9
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)
#!tag = king,自动提交,定时
#!type = normal

[Argument]
phone = input,"",tag=phone账号,desc=填入手机号/邮箱
pwd = input,"",tag=pwd密码,desc=填入密码
num = input,"",tag=num参数,desc=填入num数值
enable = switch,false,tag=启用脚本,desc=拦截请求开关
cron_enable = switch,false,tag=开启定时任务,desc=打开后后台定时执行
cron_expr = input,"*/5 * * * *",tag=Cron表达式,desc=默认每5分钟；格式：分 时 日 月 周

[Script]
# 网页访问时拦截接口
http-request ^http:\/\/8\.140\.250\.130\/king\/api\/step script-path=https://raw.githubusercontent.com/saga0924/step/refs/heads/main/king‑step.js,requires-body=true,enable={enable},argument=[{phone},{pwd},{num}]
# Cron定时后台任务，调用新的定时脚本
cron {cron_expr} script-path=https://raw.githubusercontent.com/saga0924/step/refs/heads/main/king‑cron.js,timeout=300,enable={cron_enable},argument=[{phone},{pwd},{num}]

[Mitm]
hostname = 8.140.250.130
